{
  "name": "sanding-invitation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:all": "npm run test && npm run test:integration",
    "db:indexes:dev": "node --env-file-if-exists=.env.local --import tsx scripts/setup-indexes.ts",
    "sheets:backfill:dev": "node --env-file-if-exists=.env.local --import tsx scripts/backfill-sheets.ts",
    "db:indexes:prod": "node --env-file-if-exists=.env --import tsx scripts/setup-indexes.ts",
    "sheets:backfill:prod": "node --env-file-if-exists=.env --import tsx scripts/backfill-sheets.ts"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "google-auth-library": "^11.3.4",
    "libphonenumber-js": "^1.13.16",
    "mongodb": "^7.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
