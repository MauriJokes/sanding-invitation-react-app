# Server-only environment variables. Never expose these through VITE_ variables.

MONGODB_URI=
MONGODB_DATABASE=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RSVP_WORKSHEET_NAME=Family RSVP
GOOGLE_SHEETS_GUESTBOOK_WORKSHEET_NAME=Guestbook

# Shared secret for the internal-family link (?invite=<value>). Use a long random value (>= 128 bits); server-only.
INTERNAL_INVITE_CODE=

# Salt for hashing client IPs in rate-limit keys. Use a long random value; server-only.
RATE_LIMIT_SALT=

# Public configuration only. These may be exposed to the browser if needed.
VITE_SITE_URL=
